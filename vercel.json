{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/lunch",
      "destination": "/bistro/",
      "permanent": false
    },
    {
      "source": "/lunch/",
      "destination": "/bistro/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/paperlab",
      "destination": "https://paperlab-one.vercel.app/"
    },
    {
      "source": "/paperlab/",
      "destination": "https://paperlab-one.vercel.app/"
    },
    {
      "source": "/paperlab/:path*",
      "destination": "https://paperlab-one.vercel.app/:path*"
    },
    {
      "source": "/drift",
      "destination": "https://drift-sigma-seven.vercel.app/"
    },
    {
      "source": "/drift/",
      "destination": "https://drift-sigma-seven.vercel.app/"
    },
    {
      "source": "/drift/:path*",
      "destination": "https://drift-sigma-seven.vercel.app/:path*"
    },
    {
      "source": "/logolab",
      "destination": "https://logolab-rho.vercel.app/"
    },
    {
      "source": "/logolab/",
      "destination": "https://logolab-rho.vercel.app/"
    },
    {
      "source": "/logolab/:path*",
      "destination": "https://logolab-rho.vercel.app/:path*"
    },
    {
      "source": "/bistro",
      "destination": "https://bearcat-bistro.vercel.app/bistro/"
    },
    {
      "source": "/bistro/",
      "destination": "https://bearcat-bistro.vercel.app/bistro/"
    },
    {
      "source": "/bistro/:path*",
      "destination": "https://bearcat-bistro.vercel.app/bistro/:path*"
    }
  ]
}
