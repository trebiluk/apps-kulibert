# Copy to .dev.vars (gitignored) for local runs ONLY. Never put a real secret in this example file.
ROOM_JOIN_SECRET=local-test-secret-change-me-0123456789
# wrangler dev sends the route host (class.kulibert.net, from wrangler.toml) as the Origin, so local runs must allow it too.
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,https://class.kulibert.net,http://class.kulibert.net
# Local sockets are ws://, not wss://. Production keeps the default (TLS required).
REQUIRE_TLS=0
