{
  "name": "bertopia-room-server",
  "private": true,
  "version": "0.0.0",
  "description": "Phase 0 class room server for Bertopia: presence only (alias nameplates + positions). Standalone. Not wired into the game.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "test": "npm run test:unit && npm run test:sim",
    "test:unit": "node --test test/protocol.test.mjs test/rules.test.mjs",
    "test:sim": "node --import ./test/shim/register.mjs --test test/room.sim.test.mjs test/security.sim.test.mjs",
    "test:load": "node tools/load30.mjs",
    "test:abuse": "node tools/abuse.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "ws": "^8.18.0"
  }
}
